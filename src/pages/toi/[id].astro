---
import Layout from '../../layouts/Layout.astro';
import questions from '../../data/questions.json';
import { Icon } from 'astro-icon/components';

type Question = {
  id: number;
  text: string;
};

export function getStaticPaths() {
  return questions.map((question: Question) => ({
    params: {
      id: question.id.toString(),
    },
    props: {
      question,
    },
  }));
}

const { question } = Astro.props;
---

<Layout>
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center px-6 text-center"
  >
    <div class="flex h-64 max-w-3xl items-center justify-center">
      <p class="text-3xl leading-relaxed" style="word-break: auto-phrase;">
        {question.text}
      </p>
    </div>

    <div class="mb-10 flex gap-5">
      <a
        id="share-x"
        href=`https://x.com/intent/post?text=${question.text}`
        rel="noopener noreferrer"
        target="_blank"
      >
        <Icon name="simple-icons:x" class="text-2xl" />
      </a>
    </div>

    <a href="/foooo" class="rounded-full border-2 px-4 py-2"> 別の問い </a>
  </div>
</Layout>
