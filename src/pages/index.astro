---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="text-center">
    <p id="question" class="text-2xl my-10"></p>
    <button id="next" class="border-2 px-4 py-2 rounded-full">別の問い</button>
  </div>
</Layout>

<script>
  import questions from '../data/questions.json';

  const questionElement: Element | null = document.querySelector('#question');
  const nextButton = document.querySelector('#next');

  const showRandomQuestion = () => {
    const question = questions[Math.floor(Math.random() * questions.length)];

		if (questionElement) {
			questionElement.textContent = question.question;
		}
  };

  nextButton?.addEventListener('click', showRandomQuestion);

  showRandomQuestion();
</script>
