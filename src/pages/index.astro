---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center px-6 text-center"
  >
    <div class="flex h-64 max-w-3xl items-center justify-center">
      <p
        id="question"
        class="text-3xl leading-relaxed text-emerald-500 font-bold"
        style="word-break: auto-phrase;"
      >
      </p>
    </div>

    <div class="mb-10 flex gap-5">
      <a
        id="share-x"
        href="#"
        rel="noopener noreferrer"
        target="_blank"
        class="duration-300 hover:scale-110 hover:text-emerald-500"
      >
        <Icon name="simple-icons:x" class="text-2xl" />
      </a>
    </div>

    <button
      id="next"
      class:list={[
        'rounded-full px-4 py-2 cursor-pointer shadow duration-300 bg-emerald-400 text-white',
        'hover:scale-105 hover:shadow-lg',
      ]}
    >
      別の問い
    </button>
  </div>
</Layout>

<script>
  import questions from '../data/questions.json';

  const questionElement =
    document.querySelector<HTMLParagraphElement>('#question');
  const nextButton = document.querySelector<HTMLButtonElement>('#next');
  const shareXButton = document.querySelector<HTMLAnchorElement>('#share-x');

  const updateShareUrl = (question: string) => {
    const url = new URL(`/phewww`, window.location.origin);
    const params = new URLSearchParams({
      text: question + ' #phewww',
      url: url.toString(),
    });
    if (shareXButton) {
      shareXButton.href = `https://x.com/intent/tweet?${params}`;
    }
  };

  const showRandomQuestion = () => {
    const question: string =
      questions[Math.floor(Math.random() * questions.length)];

    if (questionElement) {
      questionElement.textContent = question;
      updateShareUrl(question);
    }
  };

  nextButton?.addEventListener('click', showRandomQuestion);

  showRandomQuestion();
</script>
